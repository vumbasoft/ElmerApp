@page
@using VumbaSoft.ErmanApp.Localization
@using VumbaSoft.ErmanApp.Web.Pages.Demographics.Regions
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model CreateModalModel
@inject IStringLocalizer<ErmanAppResource> L
@{
    Layout = null;
}
<form asp-page="/Demographics/Regions/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["NewRegion"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Region.Name" />
            <abp-select asp-for="Region.SubcontinentId" asp-items="Model.Subcontinents" label="@L["Subcontinent"].Value" />
            <abp-input asp-for="Region.Population" />
            <abp-input asp-for="Region.Remarks" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
