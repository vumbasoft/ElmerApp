@page
@using VumbaSoft.ErmanApp.Localization
@using VumbaSoft.ErmanApp.Web.Pages.Demographics.Subcontinents
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model EditModalModel
@inject IStringLocalizer<ErmanAppResource> L
@{
    Layout = null;
}
<form asp-page="/Demographics/Subcontinents/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["Edit"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Subcontinent.Name" />
            <abp-select asp-for="Subcontinent.ContinentId" asp-items="Model.Continents" label="@L["Continent"].Value" />
            <abp-input asp-for="Subcontinent.Population" />
            <abp-input asp-for="Subcontinent.Remarks" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
